{
  "name": "freefiremaps",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:transform": "node scripts/verify-transform.mjs",
    "build:apk": "bash scripts/build-apk.sh",
    "ios": "expo run:ios",
    "verify:native": "node scripts/verify-native-modules.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:overlay": "node scripts/verify-overlay-bounds.mjs",
    "verify:grid": "node scripts/verify-grid.mjs",
    "verify:geometry": "node scripts/verify-geometry.mjs",
    "verify:renderer": "node scripts/verify-renderer.mjs"
  },
  "dependencies": {
    "expo": "~53.0.12",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.0"
  },
  "description": "Offline GeoPDF fire-map viewer for Android",
  "license": "MIT",
  "repository": "github:ferreratech/FreeFireMaps"
}
